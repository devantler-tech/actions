#!/usr/bin/env bash

set -euo pipefail

: "${MOCK_GH_LOG:?MOCK_GH_LOG is required}"
: "${MOCK_GH_STATE:?MOCK_GH_STATE is required}"

{
  printf "%s" "$1"
  shift
  for argument in "$@"; do
    printf "\t%s" "$argument"
  done
  printf "\n"
} >>"$MOCK_GH_LOG"

if [[ "${1:-}" == "view" ]]; then
  if [[ "${MOCK_PR_VIEW_FAIL:-false}" == "true" ]]; then
    exit 1
  fi
  printf "%s\n" "${MOCK_PR_VIEW_JSON:?MOCK_PR_VIEW_JSON is required}"
  exit 0
fi

if [[ "${1:-}" == "graphql" && "$*" == *"dequeuePullRequest"* ]]; then
  exit 0
fi

if [[ "${1:-}" == "graphql" ]]; then
  printf "%s\n" "$MOCK_GH_STATE"
  exit 0
fi

if [[ "${1:-}" == repos/*/actions/runs/* ]]; then
  if [[ "${MOCK_WORKFLOW_LOOKUP_FAIL:-false}" == "true" ]]; then
    exit 1
  fi
  printf "%s\n" "${MOCK_WORKFLOW_ID:?MOCK_WORKFLOW_ID is required}"
  exit 0
fi

if [[ "${1:-}" == repos/*/actions/runs ]]; then
  if [[ "${MOCK_RUN_LIST_FAIL:-false}" == "true" ]]; then
    exit 1
  fi
  printf "%s\n" "${MOCK_RUN_PAGE:?MOCK_RUN_PAGE is required}"
  exit 0
fi

if [[ "${1:-}" == "merge" ]]; then
  exit 0
fi

echo "unexpected mocked gh invocation" >&2
exit 1
